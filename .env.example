# =============================================================================
# crypto-trading-bot — environment checklist (NAMES ONLY, no real secrets)
# =============================================================================
# Copy to .env (gitignored) and fill values from your secret store / vault.
# NEVER commit .env, PEMs, or live tokens.
#
# Verify load:
#   python -c "import os; from pathlib import Path; print('COINBASE', bool(os.getenv('COINBASE_API_KEY')))"
# =============================================================================

# --- Coinbase Advanced Trade (CEX spot — required for live trading) ----------
# COINBASE_API_SECRET = full EC private key PEM content (multiline OK in .env).
# Keys live in env only — do not point at cb_key.pem files in-repo.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Coinbase Developer Platform / AgentKit (optional, on-chain wallets) -----
# Separate from Advanced Trade CEX keys. https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# NETWORK_ID=base-sepolia

# --- Telegram ops / alerts ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- X (Twitter) API / OAuth (sentiment + research) --------------------------
X_API_TOKEN=
X_API_SECRET=
X_API_BEARER=
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=

# --- Apify (scrapers; some code paths use TOKEN, older docs say API_KEY) ------
APIFY_API_TOKEN=
APIFY_USER_ID=
# Legacy alias still referenced in some docs/scripts:
APIFY_API_KEY=

# --- Other market / news APIs ------------------------------------------------
NEWS_API_KEY=

# --- LLM / OpenRouter (optional external models) -----------------------------
OPENROUTER_API_KEY=

# --- Encryption (T0 registry / oauth token at rest) --------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Trading mode / schedule -------------------------------------------------
# Prefer false/0 for real money. Double-check before go-live.
SANDBOX_MODE=
SANDBOX_TRADING=
DAILY_REBALANCE_TIME=09:00
SCHEDULER_TIMEZONE=America/Los_Angeles

# --- Hermes / agent paths & skill behavior (host-local; optional) ------------
MEMORY_PATH=
OUTPUT_PATH=
SKILLS_PATH=
SKILLS_WATCH=
SKILLS_AUTO_RELOAD=
MEMORY_RETRIEVAL_DEPTH=
MEMORY_RETRIEVAL_STRATEGY=
NOTIFICATION_GATEWAY=
SKILL_RETRY_ENABLED=
SKILL_RETRY_MAX=
SKILL_RETRY_DELAY=
SKILL_RETRY_NOTIFICATION=

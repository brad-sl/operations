# Coinbase Advanced API (required for trading) - ALL KEYS IN .env ONLY
# IMPORTANT: Never put secrets in repo. .env is gitignored. 
# COINBASE_API_SECRET holds the full PEM EC private key content (multiline supported).
# No file paths or cb_key.pem - keys exclusively via environment variables.
COINBASE_API_KEY=your_key_here
COINBASE_API_SECRET=your_pem_private_key_content_here

# Telegram Reporting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter / LLM keys (if using external models)
OPENROUTER_API_KEY=

# Apify (sentiment scraping)
APIFY_API_KEY=

# Optional: override rebalance time
DAILY_REBALANCE_TIME=09:00

# Prod note: For production, ensure this .env (or loaded equivalent) has live keys.
# Verify with: python -c "import os; print('KEYS LOADED' if os.getenv('COINBASE_API_KEY') else 'MISSING')"
